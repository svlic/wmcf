{
  "name": "wavemonitor-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "deploy": "node scripts/deploy.mjs && wrangler d1 migrations apply wavemonitor --remote",
    "d1:migrate:local": "wrangler d1 migrations apply wavemonitor --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wavemonitor --remote"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "hono": "^4.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^24.3.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.129.0"
  }
}
