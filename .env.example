# Copy to .env for local runs. Do not commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional shared password gate for the Web UI and /api routes. Leave blank to disable auth.
WAVEMONITOR_WEB_PASSWORD=
# Optional. When WAVEMONITOR_WEB_PASSWORD is set, a random secret is auto-generated next to the SQLite DB (or under /data in Docker) unless you set this.
WAVEMONITOR_SESSION_SECRET=
DATABASE_URL=sqlite:///./wavemonitor.sqlite3
VITE_API_BASE_URL=http://localhost:8000
# Docker compose uses DATABASE_URL=sqlite:////data/wavemonitor.sqlite3 inside the backend container.
# The frontend container proxies /api and /health to the backend service; Telegram secrets are never passed to frontend.
# Cloudflare Workers does not load this file in production. A fresh deployment is
# configured in the Web UI; existing TELEGRAM_* and WAVEMONITOR_* Wrangler secrets
remain supported as a compatibility fallback. DATABASE_URL and VITE_API_BASE_URL
are not used by the deployed Worker.
